void UART_Log(char *message) {
    HAL_UART_Transmit(&huart2, (uint8_t*)message, strlen(message), 1000);
}

HAL_StatusTypeDef MPU_6500_Init(void) {
    if(HAL_I2C_Mem_Read(&hi2c1, MPU_6500_ADDR, WHO_AM_I, 1, &check_id, 1, 10) != HAL_OK){
    	UART_Log("Device identification Failed\r\n");
    	return HAL_ERROR;
    }
    else{
    	UART_Log("Device identification Successful\r\n");
    	if (check_id == 0x70) {
    	    if(HAL_I2C_Mem_Write(&hi2c1, MPU_6500_ADDR, PWR_MGMT_1, 1, &wake_cmd, 1, 100) != HAL_OK){
    	    	UART_Log("Sensor activation failed!\r\n");
    	    	return HAL_ERROR;
    	    }
    	    else{
    	    	UART_Log("Sensor activated!\r\n");
    	    }
    	}
    }
    return HAL_OK;

}
