*/
HAL_StatusTypeDef READ_MPU_6500(uint8_t reg_add){
	  if(HAL_I2C_Mem_Read(&hi2c1, MPU_6500_ADDR, reg_add, 1, &og_data, 14, 100) != HAL_OK){
		  return HAL_ERROR;
	  }
	  else{
		UART_Log("The data at register is : ");
		HAL_UART_Transmit(&huart2, &og_data, 1, 100);
	  }
	  return HAL_OK;
}

